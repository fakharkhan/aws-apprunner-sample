# Ultra-simple test container for App Runner
FROM nginx:alpine

# Create a simple index page
RUN echo '<!DOCTYPE html><html><body><h1>App Runner Test - Working!</h1><p>If you see this, the container is working.</p></body></html>' > /usr/share/nginx/html/index.html

# Update nginx to listen on port 8000 (App Runner's expected port)
RUN sed -i 's/listen       80;/listen       8000;/' /etc/nginx/conf.d/default.conf

# Expose port 8000
EXPOSE 8000

# Nginx runs in foreground by default in alpine
CMD ["nginx", "-g", "daemon off;"]

